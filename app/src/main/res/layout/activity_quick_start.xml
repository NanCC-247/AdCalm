<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/calm_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_calm_back"
            android:contentDescription="返回" />

        <TextView
            style="@style/Calm.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="两步准备"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Calm.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="先选应用，再开启无障碍。初始为观察模式，只记录；确认结果后可在首页开启自动辅助点击。"
                android:textColor="@color/calm_text_secondary" />


            <com.google.android.material.card.MaterialCardView
                style="@style/Calm.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Calm.Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="① 开启无障碍服务"
                            android:textSize="17sp" />

                        <TextView
                            style="@style/Calm.Caption"
                            android:id="@+id/tvStep1State"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <TextView
                        style="@style/Calm.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="用于读取所选应用的页面控件。自动模式可尝试点击明确的广告关闭按钮，识别可能失败或误判。" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Calm.PrimaryButton"
                        android:id="@+id/btnStep1"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="去开启" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                style="@style/Calm.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Calm.Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="② 选择要处理的应用"
                            android:textSize="17sp" />

                        <TextView
                            style="@style/Calm.Caption"
                            android:id="@+id/tvStep2State"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <TextView
                        style="@style/Calm.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="只处理你选择的应用。建议先选一两个熟悉的应用观察，避开聊天、支付等敏感页面。" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Calm.PrimaryButton"
                        android:id="@+id/btnStep2Auto"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="14dp"
                        android:text="查看推荐范围" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Material3.Button.TextButton"
                        android:id="@+id/btnStep2Manual"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="手动选择应用"
                        android:textColor="@color/calm_primary_dark"
                        android:textAllCaps="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Calm.Body"
                android:id="@+id/tvDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/calm_primary_dark" />


            <com.google.android.material.card.MaterialCardView
                style="@style/Calm.Card"
                android:id="@+id/cardNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">


                <LinearLayout
                    android:id="@+id/rowNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Calm.Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="接下来：其余权限"
                            android:textSize="17sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_calm_chevron"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <TextView
                        style="@style/Calm.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="增强功能默认关闭，用到时再授权。\n首页「权限配置」可查看所需权限及影响。" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Calm.PrimaryButton"
                        android:id="@+id/btnGoSetup"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="去首页配置" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="其他权限（可选）" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Calm.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="4dp">

                    <LinearLayout android:id="@+id/rowShizuku" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/Calm.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Shizuku" android:textColor="@color/calm_text" />
                        <TextView style="@style/Calm.Caption" android:id="@+id/tvShizukuState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/ic_calm_chevron" android:contentDescription="@null" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/calm_outline" />

                    <LinearLayout android:id="@+id/rowUsage" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/Calm.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="使用情况访问" android:textColor="@color/calm_text" />
                        <TextView style="@style/Calm.Caption" android:id="@+id/tvUsageState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/ic_calm_chevron" android:contentDescription="@null" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/calm_outline" />

                    <LinearLayout android:id="@+id/rowNotifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/Calm.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="通知使用权" android:textColor="@color/calm_text" />
                        <TextView style="@style/Calm.Caption" android:id="@+id/tvNotificationState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/ic_calm_chevron" android:contentDescription="@null" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/calm_outline" />

                    <LinearLayout android:id="@+id/rowAllFiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/Calm.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="所有文件访问" android:textColor="@color/calm_text" />
                        <TextView style="@style/Calm.Caption" android:id="@+id/tvAllFilesState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/ic_calm_chevron" android:contentDescription="@null" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/calm_outline" />

                    <LinearLayout android:id="@+id/rowBattery" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/Calm.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="电池优化白名单" android:textColor="@color/calm_text" />
                        <TextView style="@style/Calm.Caption" android:id="@+id/tvBatteryState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/ic_calm_chevron" android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
