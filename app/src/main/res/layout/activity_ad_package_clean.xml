<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/calm_background" android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/Calm.Toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
        app:navigationContentDescription="返回" app:navigationIcon="@drawable/ic_calm_back" app:title="清理广告安装包" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp" android:background="@drawable/bg_calm_card" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_calm_icon"
                android:importantForAccessibility="no" android:padding="12dp" android:src="@drawable/ic_calm_download" app:tint="@color/calm_primary_dark" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvSummary" style="@style/Calm.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="正在扫描" android:textSize="20sp" />
                <TextView android:id="@+id/tvTotalSize" style="@style/Calm.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/tvHint" style="@style/Calm.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp" android:text="扫描别的应用缓存目录里的安装包——广告常把它们下在那里，不在下载目录里。默认勾选的是缓存残渣，删掉没有代价；其余列出来由你判断。"
            android:textColor="@color/calm_text_secondary" android:textSize="13sp" />
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/scanProgress"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:indeterminate="true" android:visibility="gone" app:trackCornerRadius="3dp" />
    </LinearLayout>

    <TextView android:id="@+id/tvListLabel" style="@style/Calm.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="20dp" android:paddingBottom="10dp" android:text="找到的安装包" android:textStyle="bold" android:visibility="gone" />

    <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:orientation="vertical" android:padding="32dp" android:visibility="gone">
        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_calm_icon"
            android:importantForAccessibility="no" android:padding="21dp" android:src="@drawable/ic_calm_check" app:tint="@color/calm_primary" />
        <TextView android:id="@+id/tvEmpty" style="@style/Calm.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:gravity="center" android:text="没有找到安装包" android:textSize="20sp" />
        <TextView android:id="@+id/tvEmptyHint" style="@style/Calm.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp"
            android:gravity="center" android:lineSpacingExtra="4dp" android:textColor="@color/calm_text_secondary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPackages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="12dp" android:scrollbars="none" />

    <LinearLayout android:id="@+id/bottomBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="20dp" android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnToggleAll" style="@style/Calm.SecondaryButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:text="全不选" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete" style="@style/Calm.PrimaryButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1.4" android:minHeight="52dp" android:text="删除" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
