<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/calm_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:paddingHorizontal="12dp" android:gravity="center_vertical">
<ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_calm_back" android:contentDescription="返回设置" />
<TextView style="@style/Calm.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="观察日志" android:textSize="22sp" android:layout_weight="1" android:layout_marginStart="8dp" />
</LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="24dp">
<FrameLayout android:layout_width="match_parent" android:layout_height="154dp" android:padding="28dp"><ImageView android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="center" android:padding="24dp" android:background="@drawable/bg_calm_icon" android:src="@drawable/ic_calm_log" android:contentDescription="@null" /></FrameLayout>
<TextView style="@style/Calm.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="查看记录量，导出排查信息" android:gravity="center" android:layout_marginBottom="24dp" />
<com.google.android.material.card.MaterialCardView style="@style/Calm.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><LinearLayout android:layout_width="match_parent" android:layout_height="126dp" android:padding="20dp" android:gravity="center_vertical"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
    <TextView style="@style/Calm.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:id="@+id/tvRecordCount" android:textSize="36sp" android:textColor="@color/calm_primary_dark" />
    <TextView style="@style/Calm.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已记录 / 条" android:textColor="@color/calm_text_secondary" /></LinearLayout><View android:layout_width="1dp" android:layout_height="42dp" android:background="@color/calm_outline" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
    <TextView style="@style/Calm.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:id="@+id/tvFileSize" android:textSize="36sp" android:textColor="@color/calm_primary_dark" />
    <TextView style="@style/Calm.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="文件大小 / KB" android:textColor="@color/calm_text_secondary" /></LinearLayout></LinearLayout></LinearLayout></com.google.android.material.card.MaterialCardView>
<TextView style="@style/Calm.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="观察模式是纯观察：只记录识别结果，不点击、不回退、不强停，也不移动文件。需要排查时，可在设置里切换模式。" android:layout_marginTop="16dp" android:layout_marginBottom="20dp" android:padding="18dp" android:background="@drawable/bg_calm_banner" android:lineSpacingExtra="5dp" />
<com.google.android.material.button.MaterialButton style="@style/Calm.PrimaryButton" android:id="@+id/btnExportLog" android:layout_width="match_parent" android:layout_height="56dp" android:text="导出日志" />
<TextView style="@style/Calm.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="导出后可以分享给其他应用" android:gravity="center" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" />
<com.google.android.material.button.MaterialButton style="@style/Calm.SecondaryButton" android:id="@+id/btnClearLog" android:layout_width="match_parent" android:layout_height="56dp" android:text="清空日志" android:textColor="@color/calm_error" />
<TextView style="@style/Calm.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="清空后无法恢复，操作前会再次确认" android:gravity="center" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" />
<com.google.android.material.card.MaterialCardView style="@style/Calm.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><LinearLayout android:id="@+id/rowDiagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="78dp" android:padding="16dp" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:background="@drawable/bg_calm_icon" android:src="@drawable/ic_calm_settings" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
    <TextView style="@style/Calm.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="诊断模式" android:textSize="16sp" />
    <TextView style="@style/Calm.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/tvDiagnosticSummary" android:layout_marginTop="4dp" /></LinearLayout>
    <TextView style="@style/Calm.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:id="@+id/tvDiagnosticState" android:layout_marginStart="6dp" />
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/ic_calm_chevron" android:contentDescription="@null" />
    </LinearLayout></LinearLayout></com.google.android.material.card.MaterialCardView>
<TextView style="@style/Calm.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="日志与截图仅保存在本机" android:layout_marginTop="16dp" android:gravity="center" />
</LinearLayout></ScrollView></LinearLayout>
