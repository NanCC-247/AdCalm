<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="@drawable/bg_calm_card" android:orientation="vertical" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_calm_icon"
            android:importantForAccessibility="no" android:padding="10dp" android:src="@drawable/ic_calm_download" app:tint="@color/calm_primary_dark" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvFileName" style="@style/Calm.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="middle" android:maxLines="2" android:textSize="15sp" />
            <TextView android:id="@+id/tvMeta" style="@style/Calm.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/tvOriginalPath" style="@style/Calm.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:ellipsize="middle" android:lineSpacingExtra="2dp" android:maxLines="2" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRestore" style="@style/Calm.SecondaryButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="恢复文件" android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete" style="@style/Calm.SecondaryButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:minHeight="48dp"
            android:text="彻底删除" android:textColor="@color/calm_error" android:textSize="13sp" app:strokeColor="@color/calm_outline" />
    </LinearLayout>
</LinearLayout>
