<!--
  教程页点「去首页配置」之后的滑动引导条。浮在图上层、贴底边，不跟着内容滚，
  这样用户滑到哪儿它都在；他自己滑够一段就淡出（见 MainActivity.onHomeScrolled）。
  箭头用 ic_calm_chevron 转 90°（右→下），弹跳方向朝下，意思是"下面还有东西"。
-->
<LinearLayout android:id="@+id/setupGuide" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="20dp" android:background="@drawable/bg_calm_banner" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="18dp" android:paddingVertical="12dp" android:visibility="gone">
<TextView style="@style/Calm.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="往下滑，还有「权限配置」" android:textColor="@color/calm_primary_dark" />
<ImageView android:id="@+id/ivGuideArrow" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="6dp" android:rotation="90" android:src="@drawable/ic_calm_chevron" android:contentDescription="@null" />
</LinearLayout>
