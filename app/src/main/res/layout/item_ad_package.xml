<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    android:background="@drawable/bg_calm_card" android:orientation="horizontal" android:padding="16dp">

    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbSelect"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top" android:layout_marginTop="6dp"
        android:minWidth="40dp" android:minHeight="40dp" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp"
        android:layout_weight="1" android:orientation="vertical" android:paddingTop="2dp">

        <TextView android:id="@+id/tvFileName" style="@style/Calm.Title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:ellipsize="middle" android:maxLines="2" android:textSize="15sp" />

        <TextView android:id="@+id/tvMeta" style="@style/Calm.Caption" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="12sp" />

        <TextView android:id="@+id/tvReason" style="@style/Calm.Caption" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" />

        <TextView android:id="@+id/tvPath" style="@style/Calm.Caption" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="middle"
            android:lineSpacingExtra="2dp" android:maxLines="2" android:textSize="11sp" />

    </LinearLayout>
</LinearLayout>
